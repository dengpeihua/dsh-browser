{
  "name": "dsh-browser-plugin",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness browser-agent plugin with Session-isolated Chromium, CDP, and DOM tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "web"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "tsdown --clean",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:smoke": "npm run build && node scripts/smoke-browser.mjs",
    "verify:package": "node --test test/package.test.mjs",
    "verify:installed": "node scripts/verify-installed-package.mjs",
    "check": "npm test && npm run verify:installed"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dengpeihua/dsh-browser.git"
  },
  "homepage": "https://github.com/dengpeihua/dsh-browser#readme",
  "bugs": {
    "url": "https://github.com/dengpeihua/dsh-browser/issues"
  },
  "dependencies": {
    "puppeteer-core": "25.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
